# Configuration de MyJob (copiée dans /etc/myjob/myjob.env par install.sh).
# Les réglages personnels (e-mails, Gmail, profil) se font dans le site, page Paramètres.

# Dossier des données : base SQLite et fichiers importés
MYJOB_DATA_DIR=/var/lib/myjob

# Le serveur n'écoute qu'en local : Caddy reçoit les connexions et gère le HTTPS
MYJOB_HOST=127.0.0.1
MYJOB_PORT=3000

# Adresse publique du site (utilisée dans les e-mails de rappel)
MYJOB_URL=https://myjob.mydouds.fr

# Cookie de session réservé au HTTPS (mettre false uniquement pour un test en HTTP)
MYJOB_SECURE_COOKIE=true

# Durée de la connexion en jours
MYJOB_SESSION_DAYS=30

# Heure d'envoi des rappels par e-mail (0-23)
MYJOB_RAPPEL_HEURE=8

# Taille maximale d'un fichier importé (Mo)
MYJOB_MAX_UPLOAD_MB=20

# Fuseau horaire (dates des relances)
TZ=Europe/Paris
